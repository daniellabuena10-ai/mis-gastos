rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Datos personales: solo su dueño
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Grupos de gastos compartidos
    match /groups/{gid} {
      allow create: if request.auth != null && request.auth.uid in request.resource.data.members;
      allow get: if request.auth != null;
      allow list: if request.auth != null && request.auth.uid in resource.data.members;
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.members ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names']) &&
         request.resource.data.members.hasAll(resource.data.members) &&
         request.resource.data.members.removeAll(resource.data.members).hasOnly([request.auth.uid])));
      allow delete: if request.auth != null && request.auth.uid == resource.data.owner;
      match /gastos/{eid} {
        allow read, write: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/groups/$(gid)).data.members;
      }
    }
  }
}
